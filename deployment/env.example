# Non-secret deployment identity. Copy to .env only if overriding defaults.
COMPOSE_PROJECT_NAME=sovereign-ai-single-node
SOVEREIGN_RUNTIME_IMAGE=sovereign-ai-runtime:0.4.0-c4
SOVEREIGN_MIGRATION_IMAGE=sovereign-ai-migrate:0.1.0-p3.1
SOVEREIGN_BOOTSTRAP_IMAGE=sovereign-ai-ollama-bootstrap:0.1.0-p3.1

# The supported first topology is deliberately fixed to one local model.
DEPLOYMENT_MODEL_ID=qwen3:4b
DEPLOYMENT_MODEL_DIGEST=sha256:359d7dd4bcdab3d86b87d73ac27966f4dbb9f5efdfcc75d34a8764a09474fae7
DEPLOYMENT_MODEL_CONTEXT_WINDOW=8192
DEPLOYMENT_OLLAMA_VERSION=0.32.5

# Replace this with a current target-host/runtime measurement. The server
# fails closed when it is absent; this example value is not certification.
DEPLOYMENT_ADMISSION_FREE_BYTES=6442450944
DEPLOYMENT_ADMISSION_HEADROOM_BYTES=536870912

# C4 request controls. The spend ceiling is zero because the supported route
# is local Ollama; set a positive bounded value only with a priced route whose
# output limit and token/cost reporting are verified.
DEPLOYMENT_MAX_CONCURRENT_RUNS_PER_USER=1
DEPLOYMENT_MAX_CONCURRENT_RUNS_PER_MODEL=1
DEPLOYMENT_MAX_RUNS_PER_USER_PER_WINDOW=60
DEPLOYMENT_RATE_WINDOW_MS=3600000
DEPLOYMENT_MAX_TOKENS_PER_USER_PER_WINDOW=1000000
DEPLOYMENT_MAX_SPEND_USD_PER_USER_PER_WINDOW=0
DEPLOYMENT_BUDGET_WINDOW_MS=86400000
DEPLOYMENT_CONTROL_LEASE_TTL_MS=660000

# Loopback is the safe default until the operator supplies approved TLS
# termination on the client network.
SOVEREIGN_INGRESS_PORT=8080
